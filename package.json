{
  "name": "@notyet.im/ui",
  "version": "0.1.0",
  "description": "NotYet UI — a dense, dark-first React design system: UI components and data-visualisation charts.",
  "type": "module",
  "license": "MIT",
  "author": "NotYet",
  "homepage": "https://github.com/notyet-im/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notyet-im/ui.git"
  },
  "bugs": {
    "url": "https://github.com/notyet-im/ui/issues"
  },
  "keywords": [
    "react",
    "design-system",
    "component-library",
    "ui-components",
    "design-tokens",
    "dataviz",
    "charts",
    "dark-mode",
    "typescript",
    "a11y"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:app",
    "build:lib": "vite build --config vite.lib.config.ts && cp src/styles/fonts.css dist/fonts.css && cp dist/index.d.ts dist/index.d.cts",
    "build:app": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "prepack": "npm run build:lib",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.5.7",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.10"
  }
}
